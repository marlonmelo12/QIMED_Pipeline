# ==============================================================================
# QIMED Health Lakehouse - Environment Variables Example
# Copie este arquivo para .env e configure os valores para o seu ambiente.
# ==============================================================================

# --- 1. Segurança & Pseudonimização LGPD (OBRIGATÓRIO) ---
# Salt criptográfico para hash HMAC SHA-256 do Master Patient Index (MPI).
# Gerar com: openssl rand -hex 32
QIMED_MPI_SALT=a3f8c1d2e4b7098fbc56e34120987654a3f8c1d2e4b7098fbc56e34120987654
SALT_SECRET=a3f8c1d2e4b7098fbc56e34120987654a3f8c1d2e4b7098fbc56e34120987654

# --- 2. Armazenamento S3 Object Storage (MinIO / AWS S3) ---
# Define se o armazenamento usará Object Storage S3 ('s3') ou Filesystem local ('local').
STORAGE_BACKEND=s3
AWS_ENDPOINT_URL=http://localhost:9000
AWS_ACCESS_KEY_ID=minio_admin
AWS_SECRET_ACCESS_KEY=minio_secret_password
AWS_REGION=us-east-1
AWS_ALLOW_HTTP=true
AWS_S3_ALLOW_UNSAFE_RENAME=true
S3_BUCKET_NAME=qimed-lakehouse

# --- 3. Integração Reativa & Webhook do Backend (ADR-001) ---
# Endpoint HTTP POST acionado ao término do pipeline para notificar o backend
# que os Data Marts DuckDB Gold estão prontos para leitura OLAP direta.
BACKEND_PIPELINE_READY_WEBHOOK_URL=http://localhost:8000/api/v1/pipeline-ready

# --- 4. Diretórios de Armazenamento do Lakehouse (Fallback local) ---
LAKEHOUSE_PATH=lakehouse/bronze
LAKEHOUSE_ROOT=lakehouse
WAREHOUSE_PATH=warehouse

# --- 5. Servidores Oficiais DATASUS & ANS ---
DATASUS_FTP_HOST=ftp.datasus.gov.br

# --- 6. Apache Airflow & Banco de Metadados ---
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://airflow:airflow@postgres:5432/airflow
AIRFLOW__WEBSERVER__SECRET_KEY=qimed_super_secret_webserver_key_2026
POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflow
POSTGRES_DB=airflow

# --- 7. Telemetria e Logs ---
LOG_LEVEL=INFO
