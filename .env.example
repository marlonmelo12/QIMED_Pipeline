# .env.example

# Lakehouse Root Path (absolute or relative)
LAKEHOUSE_PATH=/path/to/lakehouse/bronze

# DATASUS FTP Host
DATASUS_FTP_HOST=ftp.datasus.gov.br

# Secret string used to salt PII hashing (SHA-256)
SALT_SECRET=your_super_secret_salt_here

# Logging configuration (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Airflow configurations (if applicable)
AIRFLOW_HOME=/path/to/airflow/home
AIRFLOW_CONN_LAKEHOUSE=local
