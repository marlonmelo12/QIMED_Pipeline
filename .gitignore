# ==============================================================================
# QIMED Health Lakehouse - Production .gitignore
# Exclui arquivos temporários, logs, segredos e dados de execução do repositório.
# ==============================================================================

# --- 1. Python & Ambientes Virtuais ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# --- 2. Testes, Qualidade de Código & Cobertura ---
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/

# --- 3. Airflow, Logs & PIDs ---
logs/
*.log
*.pid
airflow-webserver.pid
airflow-webserver-monitor.pid
airflow.db
standalone_admin_password.txt

# --- 4. Armazenamento Lakehouse & Bases Locais ---
/lakehouse/
.collector_state/
_metadata/
temp/
tmp/
scratch/
exports/
notebooks/

# Formatos brutos e temporários de saúde
*.dbc
*.dbf
*.db
*.sqlite
*.sqlite3

# DuckDB Warehouse
warehouse/*.duckdb.wal
warehouse/*.tmp
*.duckdb.wal
!warehouse/qimed_dw.duckdb

# Parquets gerados (Preserva tabelas de domínio estáticas em config/)
*.parquet
!config/*.parquet

# Telemetria e relatórios gerados em tempo de execução
pipeline_progress.json
latest_quality_audit.json
catalog.json

# --- 5. Variáveis de Ambiente & Segredos ---
.env
.env.*
.env.local
!.env.example
*.pem
*.key
docs/


# --- 6. IDEs & Sistema Operacional ---
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini
